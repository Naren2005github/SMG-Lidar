def _compute_zones_from_track_history(track_history, frame_w, frame_h):
track_midpoints = []
for tid, pts in track_history.items():
if len(pts) >= 5:
track_midpoints.append(pts[len(pts) // 2])
fallback_zone = np.array([
[int(frame_w * 0.1), int(frame_h * 0.1)],
[int(frame_w * 0.9), int(frame_h * 0.1)],
[int(frame_w * 0.9), int(frame_h * 0.9)],
[int(frame_w * 0.1), int(frame_h * 0.9)]
], dtype=np.int32)
if not track_midpoints:
return [fallback_zone]
pts_array = np.array(track_midpoints)
eps = frame_w * 0.15
clustering = DBSCAN(eps=eps, min_samples=3).fit(pts_array)
labels = clustering.labels_
zones = []
for label in set(labels):
if label == -1:
continue
cluster_points = pts_array[labels == label]
if len(cluster_points) >= 3:
try:
hull = ConvexHull(cluster_points)
polygon = cluster_points[hull.vertices]
cx, cy = np.mean(polygon, axis=0)
expanded = []
for pt in polygon:
dir_vec = pt - [cx, cy]
expanded.append(pt + dir_vec * 0.25)
zones.append({
'polygon': np.array(expanded, dtype=np.int32),
'center': (cx, cy)
})
except Exception as e:
pass
if not zones:
return [fallback_zone]
zones.sort(key=lambda z: (z['center'][1], z['center'][0]))
return [z['polygon'] for z in zones[:4]]
