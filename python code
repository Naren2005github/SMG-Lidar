def process_single_frame(frame, zones, class_counts, model, id_remap, id_counter):
class_names_local = model.names
results = None
with _tracking_lock:
results = model.track(frame, persist=True, tracker="bytetrack.yaml", classes=VEHICLE_CLASSES, verbose=False, conf=0.10)
h, w = frame.shape[:2]
scale = max(0.6, min(1.4, w / 1280.0))
font_scale_label = 0.6 * scale
font_thickness_label = max(1, round(2 * scale))
box_thickness = max(1, round(2 * scale))
circle_radius = max(2, round(4 * scale))
overlay = frame.copy()
colors = [(0, 255, 255), (0, 165, 255), (255, 0, 0), (0, 255, 0)]
for i, poly in enumerate(zones):
color = colors[i % len(colors)]
cv2.fillPoly(overlay, [poly], color)
alpha = 0.25
frame = cv2.addWeighted(overlay, alpha, frame, 1 - alpha, 0)
for i, poly in enumerate(zones):
color = colors[i % len(colors)]
cv2.polylines(frame, [poly], isClosed=True, color=color, thickness=2)
M = cv2.moments(poly)
if M["m00"] != 0:
cx = int(M["m10"] / M["m00"])
cy = int(M["m01"] / M["m00"])
cv2.putText(frame, f"ZONE {i+1}", (cx - 30, cy), cv2.FONT_HERSHEY_SIMPLEX, 0.8 * scale, color, max(1, round(3 * scale)))
zone_vehicle_counts = {f"Zone {i+1}": 0 for i in range(len(zones))}
if results[0].boxes is not None and results[0].boxes.id is not None:
boxes = results[0].boxes.xyxy.cpu().numpy()
track_ids = results[0].boxes.id.int().cpu().tolist()
class_indices = results[0].boxes.cls.int().cpu().tolist()
for box, raw_track_id, class_idx in zip(boxes, track_ids, class_indices):
x1, y1, x2, y2 = map(int, box)
cx = (x1 + x2) // 2
cy = (y1 + y2) // 2
class_label = class_names_local[class_idx]
if raw_track_id not in id_remap:
id_remap[raw_track_id] = id_counter['next']
id_counter['next'] += 1
display_id = id_remap[raw_track_id]
cv2.rectangle(frame, (x1, y1), (x2, y2), (0, 255, 0), box_thickness)
cv2.circle(frame, (cx, cy), circle_radius, (0, 0, 255), -1)
label_text = f"ID {display_id} {class_label}"
font = cv2.FONT_HERSHEY_SIMPLEX
(text_width, text_height), _ = cv2.getTextSize(label_text, font, font_scale_label, font_thickness_label)
cv2.rectangle(frame, (x1, y1 - text_height - 10), (x1 + text_width, y1), (0, 255, 0), -1)
cv2.putText(frame, label_text, (x1, y1 - 5), font, font_scale_label, (0, 0, 0), font_thickness_label)
for i, poly in enumerate(zones):
if cv2.pointPolygonTest(poly, (float(cx), float(cy)), False) >= 0:
zone_vehicle_counts[f"Zone {i+1}"] += 1
break
class_counts.clear()
class_counts.update(zone_vehicle_counts)
box_width = round(250 * scale)
box_height = round((50 + len(class_counts) * 35) * scale)
start_x = frame.shape[1] - box_width - 10
title_font_scale = 0.9 * scale
title_thickness = max(1, round(2 * scale))
count_font_scale = 0.8 * scale
count_thickness = max(1, round(2 * scale))
cv2.rectangle(frame, (start_x, 10), (start_x + box_width, 10 + box_height), (0, 0, 0), -1)
cv2.putText(frame, "LIVE COUNTS", (start_x + 10, round(40 * scale)), cv2.FONT_HERSHEY_SIMPLEX, title_font_scale, (255, 255, 255), title_thickness)
y_offset = round(75 * scale)
for name, count in class_counts.items():
color = (0, 255, 0)
if "Zone" in name:
idx = int(name.split(" ")[1]) - 1
color = colors[idx % len(colors)]
cv2.putText(frame, f"{name}: {count}", (start_x + 10, y_offset), cv2.FONT_HERSHEY_SIMPLEX, count_font_scale, color, count_thickness)
y_offset += round(35 * scale)
return frame
