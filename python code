boxes = results[0].boxes.xyxy.cpu().numpy()
track_ids = results[0].boxes.id.int().cpu().tolist()
for box, tid in zip(boxes, track_ids):
cx, cy = (box[0] + box[2])/2, (box[1] + box[3])/2
webcam_calibration_history.setdefault(tid, []).append((cx, cy))
cv2.putText(frame, f"Calibrating Zones: {webcam_calibration_frame_count}/{WEBCAM_CALIBRATION_FRAMES}", (30, 50), cv2.FONT_HERSHEY_SIMPLEX, 0.8, (0, 0, 255), 2)
webcam_calibration_frame_count += 1
if webcam_calibration_frame_count == WEBCAM_CALIBRATION_FRAMES:
webcam_zones = _compute_zones_from_track_history(webcam_calibration_history, frame_w, frame_h)
reset_tracker(model)
_, buffer = cv2.imencode('.jpg', frame, [cv2.IMWRITE_JPEG_QUALITY, 50])
return jsonify({'processed_image': 'data:image/jpeg;base64,' + base64.b64encode(buffer).decode('utf-8')})
else:
frame = process_single_frame(frame, webcam_zones, webcam_class_counts, model, webcam_id_remap, webcam_id_counter)
send_to_iot_dashboard(webcam_class_counts)
_, buffer = cv2.imencode('.jpg', frame, [cv2.IMWRITE_JPEG_QUALITY, 50])
return jsonify({'processed_image': 'data:image/jpeg;base64,' + base64.b64encode(buffer).decode('utf-8')})
