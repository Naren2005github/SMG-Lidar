def generate_stream(source):
model_name = select_video_model(source)
model = get_model(model_name)
reset_tracker(model)
cap = cv2.VideoCapture(source)
class_counts = {}
id_remap = {}
id_counter = {'next': 1}
zones = []
track_history = {}
calibration_frames_needed = 120
frame_count = 0
while cap.isOpened():
ret, frame = cap.read()
if not ret: break
h, w = frame.shape[:2]
if not PROCESS_ORIGINAL_RESOLUTION and w > MAX_OUTPUT_WIDTH:
scale = MAX_OUTPUT_WIDTH / w
frame = cv2.resize(frame, (MAX_OUTPUT_WIDTH, int(h * scale)))
frame_h, frame_w = frame.shape[:2]
if frame_count < calibration_frames_needed:
results = model.track(frame, persist=True, tracker="bytetrack.yaml", classes=VEHICLE_CLASSES, verbose=False, conf=0.10)
if results[0].boxes is not None and results[0].boxes.id is not None:
boxes = results[0].boxes.xyxy.cpu().numpy()
track_ids = results[0].boxes.id.int().cpu().tolist()
for box, tid in zip(boxes, track_ids):
cx, cy = (box[0] + box[2])/2, (box[1] + box[3])/2
track_history.setdefault(tid, []).append((cx, cy))
cv2.putText(frame, f"Calibrating Zones: {frame_count}/{calibration_frames_needed}", (50, 50), cv2.FONT_HERSHEY_SIMPLEX, 1, (0, 0, 255), 2)
if frame_count == calibration_frames_needed - 1:
zones = _compute_zones_from_track_history(track_history, frame_w, frame_h)
reset_tracker(model)
else:
frame = process_single_frame(frame, zones, class_counts, model, id_remap, id_counter)
send_to_iot_dashboard(class_counts)
frame_count += 1
_, buffer = cv2.imencode('.jpg', frame, [cv2.IMWRITE_JPEG_QUALITY, 50])
yield (b'--frame\r\nContent-Type: image/jpeg\r\n\r\n' + buffer.tobytes() + b'\r\n')
cap.release()
export_jobs = {}
def process_and_save_async(source, job_id):
try:
model_name = select_video_model(source)
model = get_model(model_name)
reset_tracker(model)
export_jobs[job_id]['model'] = model_name
cap = cv2.VideoCapture(source)
output_path = os.path.join('static', f'{job_id}.mp4')
fps = int(cap.get(cv2.CAP_PROP_FPS))
if fps == 0: fps = 30
total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))
export_jobs[job_id]['total_frames'] = total_frames
width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))
height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
if not PROCESS_ORIGINAL_RESOLUTION and width > MAX_OUTPUT_WIDTH:
scale = MAX_OUTPUT_WIDTH / width
width = MAX_OUTPUT_WIDTH
height = int(height * scale)
out = cv2.VideoWriter(output_path, cv2.VideoWriter_fourcc(*'mp4v'), fps, (width, height))
track_history = {}
calibration_frames = min(120, total_frames // 2 if total_frames else 120)
for _ in range(calibration_frames):
ret, frame = cap.read()
if not ret: break
h, w = frame.shape[:2]
if not PROCESS_ORIGINAL_RESOLUTION and w > MAX_OUTPUT_WIDTH:
scale = MAX_OUTPUT_WIDTH / w
frame = cv2.resize(frame, (MAX_OUTPUT_WIDTH, int(h * scale)))
results = model.track(frame, persist=True, tracker="bytetrack.yaml", classes=VEHICLE_CLASSES, verbose=False, conf=0.10)
if results[0].boxes is not None and results[0].boxes.id is not None:
boxes = results[0].boxes.xyxy.cpu().numpy()
track_ids = results[0].boxes.id.int().cpu().tolist()
for box, tid in zip(boxes, track_ids):
cx, cy = (box[0] + box[2])/2, (box[1] + box[3])/2
track_history.setdefault(tid, []).append((cx, cy))
zones = _compute_zones_from_track_history(track_history, width, height)
reset_tracker(model)
cap.set(cv2.CAP_PROP_POS_FRAMES, 0) 
class_counts = {}
id_remap = {}
id_counter = {'next': 1}
frame_num = 0
while cap.isOpened():
ret, frame = cap.read()
if not ret: break
frame_num += 1
h, w = frame.shape[:2]
if not PROCESS_ORIGINAL_RESOLUTION and w > MAX_OUTPUT_WIDTH:
scale = MAX_OUTPUT_WIDTH / w
frame = cv2.resize(frame, (MAX_OUTPUT_WIDTH, int(h * scale)))
frame = process_single_frame(frame, zones, class_counts, model, id_remap, id_counter)
out.write(frame)
send_to_iot_dashboard(class_counts)
export_jobs[job_id]['frame'] = frame_num
if total_frames > 0:
export_jobs[job_id]['progress'] = min(99, int((frame_num / total_frames) * 100))
cap.release()
out.release()
export_jobs[job_id]['status'] = 'done'
export_jobs[job_id]['progress'] = 100
export_jobs[job_id]['file'] = output_path
except Exception as e:
export_jobs[job_id]['status'] = 'error'
export_jobs[job_id]['error_msg'] = str(e)
